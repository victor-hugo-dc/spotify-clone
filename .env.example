# From your app at https://developer.spotify.com/dashboard (Settings).
CLIENT_ID=
CLIENT_SECRET=

# docker compose: the public host name. Add https://<SITE_DOMAIN>/api/callback
# to the app's Redirect URIs.
SITE_DOMAIN=shoutify.example.com

# npm run dev:server: Spotify accepts http only for loopback IPs (not
# "localhost"), so register this one too for local development.
RE_URI=http://127.0.0.1:5173/api/callback
