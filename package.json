{
  "name": "shoutify",
  "version": "2.0.0",
  "private": true,
  "description": "A Spotify web player with song comments and annotations, for you and your friends.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
