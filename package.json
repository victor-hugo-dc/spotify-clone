{
  "name": "shoutify",
  "version": "2.0.0",
  "private": true,
  "description": "A Spotify web player with song comments and annotations, for you and your friends.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -p server && tsc -p client",
    "test": "node --test 'server/**/*.test.ts' 'client/src/**/*.test.ts'"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
